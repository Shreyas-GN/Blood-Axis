# ── Convex (database + auth) ──────────────────────────────────────────────────
# `npx convex dev` fills these in for you.
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# ── Firebase web config (browser push registration) ───────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-vapid-key

# ── Groq (AI parsing, used by the Next.js route) ──────────────────────────────
GROQ_API_KEY=gsk_...

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Set these on the Convex deployment, not here ──────────────────────────────
#   npx @convex-dev/auth                 -> JWT_PRIVATE_KEY, JWKS, SITE_URL
#   npx convex env set APP_URL http://localhost:3000
#   npx convex env set TWILIO_ACCOUNT_SID ...  TWILIO_AUTH_TOKEN ...  TWILIO_PHONE_NUMBER ...
#   npx convex env set FIREBASE_PROJECT_ID ... FIREBASE_CLIENT_EMAIL ... FIREBASE_PRIVATE_KEY ...
#   npx convex env set TELEGRAM_BOT_TOKEN ...  TELEGRAM_CHAT_ID ...
